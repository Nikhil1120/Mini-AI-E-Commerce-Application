# Database Configuration
# For SQLite (local development):
# DATABASE_URL=sqlite:///./ecommerce.db
# For PostgreSQL (production):
# DATABASE_URL=postgresql://user:password@localhost:5432/ecommerce
DATABASE_URL=sqlite:///./ecommerce.db

# JWT Configuration
JWT_SECRET_KEY=your-super-secret-key-change-this-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRE_HOURS=24

# Google OAuth Configuration
GOOGLE_CLIENT_ID=155172624798-ip48ds1c0i25ofvcardh034b6fvlk2vj.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Stripe Configuration
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret
# auto | true | false — auto enables mock checkout when dummy keys are used
STRIPE_MOCK_MODE=auto

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:5173

# AI Configuration
# Options: "gemini" or "openai"
AI_PROVIDER=gemini
GEMINI_API_KEY=your-gemini-api-key
OPENAI_API_KEY=your-openai-api-key

# Admin Configuration
ADMIN_EMAIL=admin@ecommerce.local

# Development mode (enables /auth/dev-login without Google OAuth)
DEV_MODE=true
